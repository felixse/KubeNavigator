<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="KubeNavigator.Views.Controls.PortForwardsPopupButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewModels="using:KubeNavigator.ViewModels"
  mc:Ignorable="d"
>
  <Grid>
    <Button
      x:Name="PortForwardsButton"
      VerticalAlignment="Stretch"
      ToolTipService.ToolTip="Forwarded Ports"
    >
      <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE704;" />
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft">
          <Grid Width="360" MaxHeight="500">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Margin="0,0,0,8"
              Style="{ThemeResource SubtitleTextBlockStyle}"
              Text="Forwarded Ports"
            />
            <ListView
              Grid.Row="1"
              ItemsSource="{x:Bind ViewModel.App.ForwardedPorts, Mode=OneWay}"
              SelectionMode="None"
            >
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ForwardedPortViewModel">
                  <Grid Padding="4,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <HyperlinkButton
                        Padding="0"
                        Command="{x:Bind OpenInBrowserCommand}"
                        Content="{x:Bind DisplayText}"
                      />
                      <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Cluster.Name}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                      <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind EditCommand}"
                        ToolTipService.ToolTip="Edit"
                      >
                        <FontIcon FontSize="12" Glyph="&#xE70F;" />
                      </Button>
                      <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind StartCommand}"
                        ToolTipService.ToolTip="Start"
                        Visibility="{x:Bind viewModels:ForwardedPortViewModel.NotActive(IsActive), Mode=OneWay}"
                      >
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                      </Button>
                      <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind StopCommand}"
                        ToolTipService.ToolTip="Stop"
                        Visibility="{x:Bind viewModels:ForwardedPortViewModel.Active(IsActive), Mode=OneWay}"
                      >
                        <FontIcon FontSize="12" Glyph="&#xE71A;" />
                      </Button>
                      <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind DeleteCommand}"
                        ToolTipService.ToolTip="Delete"
                      >
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock
              Grid.Row="1"
              Margin="0,8,0,0"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="No forwarded ports"
              Visibility="{x:Bind ViewModel.App.ForwardedPorts.Count, Mode=OneWay, Converter={StaticResource ZeroCountToVisibleConverter}}"
            />
          </Grid>
        </Flyout>
      </Button.Flyout>
    </Button>
    <InfoBadge
      Margin="0,-4,-4,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      IsHitTestVisible="False"
      Visibility="{x:Bind ViewModel.App.ForwardedPorts.Count, Mode=OneWay, Converter={StaticResource CountToVisibleConverter}}"
      Value="{x:Bind ViewModel.App.ForwardedPorts.Count, Mode=OneWay}"
    />
  </Grid>
</UserControl>
