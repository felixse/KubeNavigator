<ResourceDictionary
  x:Class="KubeNavigator.Views.Resources.SecretResources"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:customcontrols="using:KubeNavigator.Views.Controls"
  xmlns:local="using:KubeNavigator.Views.Resources"
  xmlns:resources="using:KubeNavigator.ViewModels.Resources"
  xmlns:viewmodels="using:KubeNavigator.ViewModels"
>
  <DataTemplate
    x:Key="SecretTableHeader"
    x:DataType="viewmodels:KubernetesResourceTypeListViewModel"
  >
    <controls:DataTable ColumnSpacing="16">
      <controls:DataColumn Margin="12,0,0,0" DesiredWidth="Auto">
        <CheckBox MinWidth="36" IsChecked="{x:Bind IsAllSelected, Mode=TwoWay}" />
      </controls:DataColumn>
      <controls:DataColumn CanResize="True" Content="Name" DesiredWidth="Auto" />
      <controls:DataColumn CanResize="True" Content="Namespace" DesiredWidth="Auto" />
      <controls:DataColumn CanResize="True" Content="Keys" DesiredWidth="Auto" />
      <controls:DataColumn CanResize="True" Content="Type" DesiredWidth="Auto" />
      <controls:DataColumn CanResize="True" Content="Age" DesiredWidth="Auto" />
    </controls:DataTable>
  </DataTemplate>
  <DataTemplate x:Key="SecretTableRow" x:DataType="resources:SecretViewModel">
    <controls:DataRow
      HorizontalAlignment="Left"
      Background="Transparent"
      ContextFlyout="{x:Bind Converter={StaticResource ListItemToMenuConverter}}"
    >
      <CheckBox MinWidth="36" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Namespace}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Keys, Mode=OneWay}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Type, Mode=OneWay}" />
      <customcontrols:AgeTextBlock VerticalAlignment="Center" Timestamp="{x:Bind Age}" />
    </controls:DataRow>
  </DataTemplate>
</ResourceDictionary>
