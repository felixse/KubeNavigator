<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="KubeNavigator.Views.ClusterMetricsCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  HorizontalAlignment="Stretch"
  HorizontalContentAlignment="Stretch"
  mc:Ignorable="d"
>
  <Border
    MinHeight="120"
    Padding="16"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="4"
  >
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}" />
      </StackPanel>
      <Grid Grid.Column="1" Width="90" Height="90">
        <ProgressRing
          Width="90"
          Height="90"
          Background="{ThemeResource CardStrokeColorDefaultBrush}"
          IsIndeterminate="False"
          Maximum="100"
          Minimum="0"
          Value="{x:Bind ViewModel.Percentage, Mode=OneWay}"
        />
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          Text="{x:Bind ViewModel.PercentageText, Mode=OneWay}"
        />
      </Grid>
    </Grid>
  </Border>
</UserControl>
