<ResourceDictionary
  x:Class="KubeNavigator.Views.Resources.NamespaceResources"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:customcontrols="using:KubeNavigator.Views.Controls"
  xmlns:local="using:KubeNavigator.Views.Resources"
  xmlns:resources="using:KubeNavigator.ViewModels.Resources"
  xmlns:viewmodels="using:KubeNavigator.ViewModels"
>
  <DataTemplate
    x:Key="NamespaceTableHeader"
    x:DataType="viewmodels:KubernetesResourceTypeListViewModel"
  >
    <controls:DataTable ColumnSpacing="16">
      <controls:DataColumn Margin="12,0,0,0" DesiredWidth="Auto">
        <CheckBox MinWidth="36" IsChecked="{x:Bind IsAllSelected, Mode=TwoWay}" />
      </controls:DataColumn>
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Name"
        DesiredWidth="Auto"
      />
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Labels"
        DesiredWidth="Auto"
      />
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Age"
        DesiredWidth="Auto"
      />
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Status"
        DesiredWidth="Auto"
      />
    </controls:DataTable>
  </DataTemplate>
  <DataTemplate x:Key="NamespaceTableRow" x:DataType="resources:NamespaceViewModel">
    <controls:DataRow
      HorizontalAlignment="Left"
      Background="Transparent"
      ContextFlyout="{x:Bind Converter={StaticResource ListItemToMenuConverter}}"
    >
      <CheckBox MinWidth="36" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Labels}" />
      <customcontrols:AgeTextBlock VerticalAlignment="Center" Timestamp="{x:Bind Age}" />
      <customcontrols:StatusTextBlock VerticalAlignment="Center" Status="{x:Bind Status, Mode=OneWay}" />
    </controls:DataRow>
  </DataTemplate>
</ResourceDictionary>
