<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="KubeNavigator.Views.ResourceCreateView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:editor="using:WinUIEditor"
  xmlns:local="using:KubeNavigator.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Grid Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBlock Margin="4" VerticalAlignment="Center" Text="New:" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{ThemeResource BodyStrongTextBlockStyle}"
          Text="{x:Bind ViewModel.ResourceType.SingularDisplayName}"
        />
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Margin="4" Command="{x:Bind ViewModel.CreateCommand}" Content="Create" />
        <Button
          Margin="4"
          Command="{x:Bind ViewModel.CreateAndCloseCommand}"
          Content="Create and Close"
          Style="{ThemeResource AccentButtonStyle}"
        />
      </StackPanel>
    </Grid>
    <editor:CodeEditorControl
      x:Name="Editor"
      Grid.Row="1"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      HighlightingLanguage="yaml"
    />
  </Grid>
</UserControl>
