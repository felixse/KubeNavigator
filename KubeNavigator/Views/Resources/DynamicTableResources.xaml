<ResourceDictionary
  x:Class="KubeNavigator.Views.Resources.DynamicTableResources"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="using:KubeNavigator.Views"
  xmlns:controls="using:KubeNavigator.Views.Controls"
>
  <DataTemplate x:Key="DynamicTableHeaderTemplate">
    <views:DynamicTableHeaderControl />
  </DataTemplate>
  <DataTemplate x:Key="DynamicTableRowTemplate">
    <views:DynamicTableRowControl />
  </DataTemplate>
  <DataTemplate x:Key="ContainerStatusItemTemplate">
    <views:ContainerStatusView />
  </DataTemplate>
  <DataTemplate x:Key="ConditionStatusItemTemplate">
    <controls:StatusTextBlock />
  </DataTemplate>
</ResourceDictionary>

