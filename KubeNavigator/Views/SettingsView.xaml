<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="KubeNavigator.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:KubeNavigator.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Grid MinWidth="600" MaxWidth="1500">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="64" Padding="8">
      <TextBlock
        VerticalAlignment="Center"
        Style="{ThemeResource SubtitleTextBlockStyle}"
        Text="Settings"
      />
    </Border>
    <SelectorBar
      x:Name="SettingsTabs"
      Grid.Row="1"
      Margin="0,0,0,16"
      SelectionChanged="SettingsTabs_SelectionChanged"
    >
      <SelectorBarItem x:Name="GeneralTab" IsSelected="True" Text="General" />
      <SelectorBarItem x:Name="AboutTab" Text="About" />
    </SelectorBar>

    <!--  General tab content  -->
    <StackPanel x:Name="GeneralPanel" Grid.Row="2" Spacing="4">
      <controls:SettingsCard Header="Application Theme">
        <ComboBox
          x:Name="ThemeComboBox"
          ItemsSource="{x:Bind ViewModel.AvailableThemes}"
          SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
        />
      </controls:SettingsCard>
      <controls:SettingsCard
        Description="Leave empty to use helm from PATH."
        Header="Custom helm.exe Path"
      >
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox
            MinWidth="300"
            PlaceholderText="helm"
            Text="{x:Bind ViewModel.HelmPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
          />
          <Button Command="{x:Bind ViewModel.BrowseHelmPathCommand}" Content="Browse..." />
        </StackPanel>
      </controls:SettingsCard>
      <controls:SettingsCard
        Description="Hide metadata.managedFields from resource YAML."
        Header="Hide Managed Fields"
      >
        <ToggleSwitch IsOn="{x:Bind ViewModel.HideManagedFields, Mode=TwoWay}" />
      </controls:SettingsCard>
      <controls:SettingsCard
        Description="Resets pinned items, expanded groups, and last selected namespace filters."
        Header="Reset View State"
      >
        <Button Click="ResetViewState_Click" Content="Reset" />
      </controls:SettingsCard>
    </StackPanel>

    <!--  About tab content  -->
    <ScrollViewer x:Name="AboutPanel" Grid.Row="2" VerticalAlignment="Top" Visibility="Collapsed">
      <ScrollViewer.Resources>
        <Style BasedOn="{StaticResource DefaultHyperlinkButtonStyle}" TargetType="HyperlinkButton">
          <Setter Property="Margin" Value="-12,0,0,0" />
        </Style>
      </ScrollViewer.Resources>
      <StackPanel Spacing="4">
        <controls:SettingsExpander
          Description="© 2026. All rights reserved."
          Header="KubeNavigator"
        >
          <controls:SettingsExpander.HeaderIcon>
            <BitmapIcon
              ShowAsMonochrome="False"
              UriSource="ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-32.png"
            />
          </controls:SettingsExpander.HeaderIcon>
          <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.AppVersion}"
          />
          <controls:SettingsExpander.Items>
            <controls:SettingsCard
              HorizontalContentAlignment="Left"
              ContentAlignment="Vertical"
              Header="License"
            >
              <HyperlinkButton
                Content="GNU General Public License v3.0"
                NavigateUri="https://github.com/felixse/KubeNavigator/blob/main/LICENSE"
              />
            </controls:SettingsCard>
            <controls:SettingsCard
              HorizontalContentAlignment="Left"
              ContentAlignment="Vertical"
              Header="Dependencies"
            >
              <StackPanel>
                <HyperlinkButton
                  Content="CliWrap"
                  NavigateUri="https://github.com/Tyrrrz/CliWrap"
                />
                <HyperlinkButton
                  Content="FuseSharp"
                  NavigateUri="https://github.com/felixse/FuseSharp"
                />
                <HyperlinkButton
                  Content="KubernetesClient"
                  NavigateUri="https://github.com/kubernetes-client/csharp"
                />
                <HyperlinkButton
                  Content="Nito.AsyncEx"
                  NavigateUri="https://github.com/StephenCleary/AsyncEx"
                />
                <HyperlinkButton
                  Content="Serilog"
                  NavigateUri="https://github.com/serilog/serilog"
                />
                <HyperlinkButton
                  Content="SystemTextJson.JsonDiffPatch"
                  NavigateUri="https://github.com/weichch/system-text-json-jsondiffpatch"
                />
                <HyperlinkButton
                  Content="ts-pattern"
                  NavigateUri="https://github.com/gvergnaud/ts-pattern"
                />
                <HyperlinkButton
                  Content="Windows App SDK"
                  NavigateUri="https://github.com/microsoft/WindowsAppSDK"
                />
                <HyperlinkButton
                  Content="Windows Community Toolkit"
                  NavigateUri="https://github.com/CommunityToolkit/Windows"
                />
                <HyperlinkButton
                  Content="WinUIEdit"
                  NavigateUri="https://github.com/BreeceW/WinUIEdit"
                />
                <HyperlinkButton
                  Content="WinUIEx"
                  NavigateUri="https://github.com/dotMorten/WinUIEx"
                />
                <HyperlinkButton
                  Content="xterm.js"
                  NavigateUri="https://github.com/xtermjs/xterm.js"
                />
              </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard
              HorizontalContentAlignment="Left"
              ContentAlignment="Vertical"
              Header="Links"
            >
              <StackPanel>
                <HyperlinkButton
                  Content="GitHub repository"
                  NavigateUri="https://github.com/felixse/KubeNavigator"
                />
                <HyperlinkButton
                  Content="Report an issue"
                  NavigateUri="https://github.com/felixse/KubeNavigator/issues"
                />
              </StackPanel>
            </controls:SettingsCard>
          </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <controls:SettingsCard Description="{x:Bind ViewModel.LogDirectory}" Header="Log Files">
          <HyperlinkButton
            Command="{x:Bind ViewModel.OpenLogDirectoryCommand}"
            Content="Open log directory"
          />
        </controls:SettingsCard>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
