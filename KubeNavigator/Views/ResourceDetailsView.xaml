<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="KubeNavigator.Views.ResourceDetailsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:converters="using:KubeNavigator.Converters"
  xmlns:customcontrols="using:KubeNavigator.Views.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:details="using:KubeNavigator.ViewModels.Details"
  xmlns:editor="using:WinUIEditor"
  xmlns:local="using:KubeNavigator.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:templateselectors="using:KubeNavigator.TemplateSelectors"
  xmlns:viewmodels="using:KubeNavigator.ViewModels"
  x:Name="Foo"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <Style x:Key="DetailsRowHeaderStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="DetailsValueTextStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsTextSelectionEnabled" Value="True" />
      <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="ConditionBorderStyle" TargetType="Border">
      <Setter Property="Padding" Value="8,4,8,4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="ConditionTextStyle" TargetType="TextBlock">
      <Setter Property="IsTextSelectionEnabled" Value="True" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style
      x:Key="ConditionInverseTextStyle"
      BasedOn="{StaticResource ConditionTextStyle}"
      TargetType="TextBlock"
    >
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorInverseBrush}" />
    </Style>
    <Style x:Key="CodeEditorStyle" TargetType="editor:CodeEditorControl">
      <Setter Property="Height" Value="200" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="PortsAppBarButtonStyle" TargetType="AppBarButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="48" />
    </Style>
    <DataTemplate
      x:Key="DetailsConditionElementTemplate"
      x:DataType="details:DetailsConditionsElement"
    >
      <controls:SwitchPresenter Value="{x:Bind Status}">
        <controls:Case Value="True">
          <controls:SwitchPresenter Value="{x:Bind KindString}">
            <controls:Case Value="Positive">
              <Border
                Background="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource ConditionBorderStyle}"
              >
                <TextBlock
                  Style="{StaticResource ConditionInverseTextStyle}"
                  Text="{x:Bind Type}"
                  ToolTipService.ToolTip="{x:Bind DetailsText}"
                />
              </Border>
            </controls:Case>
            <controls:Case Value="Negative">
              <Border
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource ConditionBorderStyle}"
              >
                <TextBlock
                  Style="{StaticResource ConditionInverseTextStyle}"
                  Text="{x:Bind Type}"
                  ToolTipService.ToolTip="{x:Bind DetailsText}"
                />
              </Border>
            </controls:Case>
            <controls:Case Value="Neutral">
              <Border
                Background="{ThemeResource SystemFillColorAttentionBrush}"
                Style="{StaticResource ConditionBorderStyle}"
              >
                <TextBlock
                  Style="{StaticResource ConditionInverseTextStyle}"
                  Text="{x:Bind Type}"
                  ToolTipService.ToolTip="{x:Bind DetailsText}"
                />
              </Border>
            </controls:Case>
          </controls:SwitchPresenter>
        </controls:Case>
        <controls:Case Value="False">
          <controls:SwitchPresenter Value="{x:Bind Kind}">
            <controls:Case Value="Positive">
              <Border
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                Style="{StaticResource ConditionBorderStyle}"
              >
                <TextBlock
                  Style="{StaticResource ConditionTextStyle}"
                  Text="{x:Bind Type}"
                  ToolTipService.ToolTip="{x:Bind DetailsText}"
                />
              </Border>
            </controls:Case>
            <controls:Case Value="Negative">
              <Border
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                Style="{StaticResource ConditionBorderStyle}"
              >
                <TextBlock
                  Style="{StaticResource ConditionTextStyle}"
                  Text="{x:Bind Type}"
                  ToolTipService.ToolTip="{x:Bind DetailsText}"
                />
              </Border>
            </controls:Case>
          </controls:SwitchPresenter>
        </controls:Case>
      </controls:SwitchPresenter>
    </DataTemplate>
    <DataTemplate
      x:Key="DetailsCollectionItemElementTemplate"
      x:DataType="details:DetailsCollectionItemElement"
    >
      <StackPanel>
        <Border
          Padding="8,4,8,4"
          Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
          BorderThickness="1"
          CornerRadius="2"
        >
          <TextBlock
            IsTextSelectionEnabled="True"
            Text="{x:Bind Value}"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind Value}"
          />
        </Border>
        <TextBlock
          IsTextSelectionEnabled="True"
          Text="{x:Bind SecondaryValue}"
          TextTrimming="CharacterEllipsis"
          Visibility="{x:Bind SecondaryValue, Converter={StaticResource NullToCollapsedConverter}}"
        />
      </StackPanel>
    </DataTemplate>
    <templateselectors:DetailsContentTemplateSelector x:Key="DetailsContentTemplateSelector">
      <templateselectors:DetailsContentTemplateSelector.TextTemplate>
        <DataTemplate x:DataType="details:DetailsTextItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <controls:SwitchPresenter Grid.Column="1" Value="{x:Bind ValueColorString}">
              <controls:Case Value="Success">
                <TextBlock
                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                  Style="{StaticResource DetailsValueTextStyle}"
                  Text="{x:Bind Value}"
                />
              </controls:Case>
              <controls:Case Value="Info">
                <TextBlock
                  Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                  Style="{StaticResource DetailsValueTextStyle}"
                  Text="{x:Bind Value}"
                />
              </controls:Case>
              <controls:Case Value="Warning">
                <TextBlock
                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                  Style="{StaticResource DetailsValueTextStyle}"
                  Text="{x:Bind Value}"
                />
              </controls:Case>
              <controls:Case Value="Error">
                <TextBlock
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                  Style="{StaticResource DetailsValueTextStyle}"
                  Text="{x:Bind Value}"
                />
              </controls:Case>
              <controls:Case Value="Default">
                <TextBlock
                  Style="{StaticResource DetailsValueTextStyle}"
                  Text="{x:Bind Value}"
                />
              </controls:Case>
            </controls:SwitchPresenter>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.TextTemplate>
      <templateselectors:DetailsContentTemplateSelector.CollectionTemplate>
        <DataTemplate x:DataType="details:DetailsCollectionItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <ItemsControl
              Grid.Column="1"
              MaxWidth="360"
              HorizontalAlignment="Left"
              ItemTemplate="{StaticResource DetailsCollectionItemElementTemplate}"
              ItemsSource="{x:Bind Items}"
            >
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:WrapPanel
                    HorizontalSpacing="4"
                    VerticalSpacing="4"
                  />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.CollectionTemplate>
      <templateselectors:DetailsContentTemplateSelector.CollectionStackTemplate>
        <DataTemplate x:DataType="details:DetailsCollectionItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <ItemsRepeater
              Grid.Column="1"
              MaxWidth="360"
              HorizontalAlignment="Left"
              ItemTemplate="{StaticResource DetailsCollectionItemElementTemplate}"
              ItemsSource="{x:Bind Items}"
            >
              <ItemsRepeater.Layout>
                <StackLayout Spacing="4" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.CollectionStackTemplate>
      <templateselectors:DetailsContentTemplateSelector.LinkTemplate>
        <DataTemplate x:DataType="details:DetailsLinkItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource DetailsRowHeaderStyle}"
              Text="{x:Bind Title}"
            />
            <Border Grid.Column="1">
              <HyperlinkButton
                Padding="2"
                Click="HyperlinkButton_Click"
                Visibility="{x:Bind ResourceName, Converter={StaticResource NullToCollapsedConverter}}"
              >
                <HyperlinkButton.Content>
                  <TextBlock>
                    <Run Text="{x:Bind Prefix}" />
                    <Run Text="{x:Bind ResourceName}" />
                  </TextBlock>
                </HyperlinkButton.Content>
              </HyperlinkButton>
            </Border>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.LinkTemplate>
      <templateselectors:DetailsContentTemplateSelector.PortsTemplate>
        <DataTemplate x:DataType="details:DetailsPortsItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="Ports" />
            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Ports}">
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:PortViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton
                      Padding="2"
                      VerticalAlignment="Center"
                      Command="{x:Bind InvokeCommand}"
                      Content="{x:Bind Link, Mode=OneWay}"
                    />
                    <controls:SwitchPresenter
                      VerticalAlignment="Center"
                      Value="{x:Bind ForwardedPort.Status, Converter={StaticResource ToStringConverter}, Mode=OneWay}"
                    >
                      <controls:Case Value="{x:Null}">
                        <Button
                          Command="{x:Bind ShowForwardingDialogCommand}"
                          Content="Forward..."
                          Style="{StaticResource AccentButtonStyle}"
                        />
                      </controls:Case>
                      <controls:Case Value="Active">
                        <AppBarButton
                          Command="{x:Bind StopCommand}"
                          Style="{StaticResource PortsAppBarButtonStyle}"
                          ToolTipService.ToolTip="Stop"
                        >
                          <AppBarButton.Icon>
                            <SymbolIcon Symbol="Stop" />
                          </AppBarButton.Icon>
                        </AppBarButton>
                      </controls:Case>
                      <controls:Case Value="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <AppBarButton
                            Command="{x:Bind StartCommand}"
                            Style="{StaticResource PortsAppBarButtonStyle}"
                            ToolTipService.ToolTip="Start"
                          >
                            <AppBarButton.Icon>
                              <SymbolIcon Symbol="Play" />
                            </AppBarButton.Icon>
                          </AppBarButton>
                          <AppBarButton
                            Command="{x:Bind ShowForwardingDialogCommand}"
                            Style="{StaticResource PortsAppBarButtonStyle}"
                            ToolTipService.ToolTip="Edit"
                          >
                            <AppBarButton.Icon>
                              <SymbolIcon Symbol="Edit" />
                            </AppBarButton.Icon>
                          </AppBarButton>
                          <AppBarButton
                            Command="{x:Bind DeleteForwardedPortCommand}"
                            Style="{StaticResource PortsAppBarButtonStyle}"
                            ToolTipService.ToolTip="Delete"
                          >
                            <AppBarButton.Icon>
                              <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                          </AppBarButton>
                        </StackPanel>
                      </controls:Case>
                    </controls:SwitchPresenter>
                  </StackPanel>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
              <ItemsRepeater.Layout>
                <StackLayout Spacing="4" />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.PortsTemplate>
      <templateselectors:DetailsContentTemplateSelector.TableTemplate>
        <DataTemplate x:DataType="details:DetailsTableItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <Expander
              Grid.Column="1"
              MinHeight="24"
              Padding="0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Header="{x:Bind Count, Mode=OneWay}"
            >
              <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
              >
                <customcontrols:SimpleTable
                  Margin="16,0,16,16"
                  Columns="{x:Bind Columns}"
                  Rows="{x:Bind Rows}"
                />
              </ScrollViewer>
            </Expander>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.TableTemplate>
      <templateselectors:DetailsContentTemplateSelector.TableInlineTemplate>
        <DataTemplate x:DataType="details:DetailsTableItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <Border
              Grid.Column="1"
              Margin="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
            >
              <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
              >
                <customcontrols:SimpleTable
                  Margin="8"
                  Columns="{x:Bind Columns}"
                  Rows="{x:Bind Rows}"
                />
              </ScrollViewer>
            </Border>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.TableInlineTemplate>
      <templateselectors:DetailsContentTemplateSelector.DictionaryTemplate>
        <DataTemplate x:DataType="details:DetailsDictionaryItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <Border Grid.Column="1" Background="Transparent">
              <Border.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Command="{x:Bind CopyAsJsonCommand}" Text="Copy as JSON" />
                  <MenuFlyoutItem Command="{x:Bind CopyAsYamlCommand}" Text="Copy as YAML" />
                </MenuFlyout>
              </Border.ContextFlyout>
              <ItemsRepeater ItemsSource="{x:Bind Items}">
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="details:DetailsDictionaryEntry">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Key}"
                      />
                      <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Value}"
                      />
                    </StackPanel>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </Border>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.DictionaryTemplate>
      <templateselectors:DetailsContentTemplateSelector.MarkdownTemplate>
        <DataTemplate x:DataType="details:DetailsMarkdownItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <controls:MarkdownTextBlock
              Grid.Column="1"
              Margin="8,0,0,0"
              Config="{x:Bind local:ResourceDetailsView.GetMarkdownConfig()}"
              Text="{x:Bind Value}"
            />
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.MarkdownTemplate>
      <templateselectors:DetailsContentTemplateSelector.ConditionsTemplate>
        <DataTemplate x:DataType="details:DetailsConditionsItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <ItemsControl
              Grid.Column="1"
              MaxWidth="360"
              HorizontalAlignment="Left"
              ItemTemplate="{StaticResource DetailsConditionElementTemplate}"
              ItemsSource="{x:Bind Items}"
            >
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:WrapPanel
                    HorizontalSpacing="4"
                    VerticalSpacing="4"
                  />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.ConditionsTemplate>
      <templateselectors:DetailsContentTemplateSelector.EditorTemplate>
        <DataTemplate x:DataType="details:DetailsEditorItem">
          <Grid Margin="0,4,0,4" RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <editor:CodeEditorControl
              Grid.Row="1"
              DataContext="{x:Bind}"
              HighlightingLanguage="yaml"
              Loaded="CodeEditorControl_Loaded"
              Style="{StaticResource CodeEditorStyle}"
            />
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.EditorTemplate>
      <templateselectors:DetailsContentTemplateSelector.EditorColumnTemplate>
        <DataTemplate x:DataType="details:DetailsEditorItem">
          <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DetailsRowHeaderStyle}" Text="{x:Bind Title}" />
            <editor:CodeEditorControl
              Grid.Column="1"
              DataContext="{x:Bind}"
              HighlightingLanguage="yaml"
              Loaded="CodeEditorControl_Loaded"
              Style="{StaticResource CodeEditorStyle}"
            />
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsContentTemplateSelector.EditorColumnTemplate>
    </templateselectors:DetailsContentTemplateSelector>
    <templateselectors:DetailsSectionTemplateSelector x:Key="DetailsSectionTemplateSelector">
      <templateselectors:DetailsSectionTemplateSelector.SectionTemplate>
        <DataTemplate x:DataType="details:DetailsSection">
          <Grid RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
              Style="{ThemeResource SubtitleTextBlockStyle}"
              Text="{x:Bind Header}"
              Visibility="{x:Bind Header, Converter={StaticResource NullToCollapsedConverter}}"
            />
            <ItemsControl
              Grid.Row="1"
              ItemTemplateSelector="{StaticResource DetailsContentTemplateSelector}"
              ItemsSource="{x:Bind Items}"
            >
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <customcontrols:DetailsPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid
              Grid.Row="2"
              Margin="8,0,0,0"
              Visibility="{x:Bind SaveCommand, Converter={StaticResource NullToCollapsedConverter}}"
            >
              <Button
                Command="{x:Bind SaveCommand}"
                CommandParameter="{x:Bind}"
                Content="Save"
                Style="{ThemeResource AccentButtonStyle}"
              />
            </Grid>
          </Grid>
        </DataTemplate>
      </templateselectors:DetailsSectionTemplateSelector.SectionTemplate>
      <templateselectors:DetailsSectionTemplateSelector.GroupedSectionTemplate>
        <DataTemplate x:DataType="details:GroupedDetailsSection">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,8"
              Style="{ThemeResource SubtitleTextBlockStyle}"
              Text="{x:Bind Title}"
            />
            <ItemsRepeater ItemsSource="{x:Bind Groups}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="8" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="details:DetailsGroup">
                  <Border
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                  >
                    <StackPanel>
                      <StackPanel
                        Padding="16"
                        Background="{ThemeResource ExpanderHeaderBackground}"
                        Orientation="Horizontal"
                        Spacing="8"
                      >
                        <FontIcon
                          FontSize="16"
                          Glyph="{x:Bind Header.Symbol}"
                          Visibility="{x:Bind Header.Symbol, Converter={StaticResource NullToCollapsedConverter}}"
                        />
                        <controls:SwitchPresenter Value="{x:Bind Header.CategoryString}">
                          <controls:Case Value="Warning">
                            <TextBlock
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              Text="{x:Bind Header.Title}"
                            />
                          </controls:Case>
                          <controls:Case IsDefault="True">
                            <TextBlock Text="{x:Bind Header.Title}" />
                          </controls:Case>
                        </controls:SwitchPresenter>
                      </StackPanel>
                      <Border
                        Height="1"
                        BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                        BorderThickness="1"
                      />
                      <Border Padding="16" Background="{ThemeResource ExpanderContentBackground}">
                        <ItemsControl
                          ItemTemplateSelector="{StaticResource DetailsContentTemplateSelector}"
                          ItemsSource="{x:Bind Items}"
                        >
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <customcontrols:DetailsPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </DataTemplate>
      </templateselectors:DetailsSectionTemplateSelector.GroupedSectionTemplate>
    </templateselectors:DetailsSectionTemplateSelector>
  </UserControl.Resources>
  <ScrollViewer x:Name="DetailScrollViewer" VerticalScrollBarVisibility="Auto">
    <ItemsControl
      Margin="8,8,16,8"
      ItemTemplateSelector="{StaticResource DetailsSectionTemplateSelector}"
      ItemsSource="{x:Bind ViewModel.Details, Mode=OneWay}"
    />
  </ScrollViewer>
</UserControl>
