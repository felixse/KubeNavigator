<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="KubeNavigator.Views.ResourceEditView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:editor="using:WinUIEditor"
  xmlns:local="using:KubeNavigator.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Grid Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBlock Margin="4" VerticalAlignment="Center" Text="Kind:" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{ThemeResource BodyStrongTextBlockStyle}"
          Text="{x:Bind ViewModel.Resource.Resource.Kind}"
        />
        <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" Text="Name:" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{ThemeResource BodyStrongTextBlockStyle}"
          Text="{x:Bind ViewModel.Resource.Name}"
        />
        <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" Text="Namespace:" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{ThemeResource BodyStrongTextBlockStyle}"
          Text="{x:Bind ViewModel.Resource.Namespace}"
        />
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Margin="4" Command="{x:Bind ViewModel.SaveCommand}" Content="Save" />
        <Button
          Margin="4"
          Command="{x:Bind ViewModel.SaveAndCloseCommand}"
          Content="Save and Close"
          Style="{ThemeResource AccentButtonStyle}"
        />
      </StackPanel>
    </Grid>
    <ProgressRing x:Name="ProgressRing" Grid.Row="1" />
    <editor:CodeEditorControl
      x:Name="Editor"
      Grid.Row="1"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      HighlightingLanguage="yaml"
      Visibility="Collapsed"
    />
    <Border
      x:Name="SearchOverlay"
      Grid.Row="1"
      Margin="8"
      Padding="8"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4"
      Visibility="Collapsed"
    >
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBox
          x:Name="SearchBox"
          Width="250"
          PlaceholderText="Find..."
          TextChanged="SearchBox_TextChanged"
        >
          <TextBox.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Invoked="SearchNextAccelerator_Invoked" />
            <KeyboardAccelerator
              Key="Enter"
              Invoked="SearchPrevAccelerator_Invoked"
              Modifiers="Shift"
            />
            <KeyboardAccelerator Key="Escape" Invoked="CloseSearchAccelerator_Invoked" />
          </TextBox.KeyboardAccelerators>
        </TextBox>
        <Button
          Background="Transparent"
          BorderThickness="0"
          Click="SearchNext_Click"
          Content="&#xE70E;"
          FontFamily="{ThemeResource SymbolThemeFontFamily}"
          ToolTipService.ToolTip="Next (Enter)"
        />
        <Button
          Background="Transparent"
          BorderThickness="0"
          Click="SearchPrev_Click"
          Content="&#xE70D;"
          FontFamily="{ThemeResource SymbolThemeFontFamily}"
          ToolTipService.ToolTip="Previous (Shift+Enter)"
        />
        <Button
          Background="Transparent"
          BorderThickness="0"
          Click="CloseSearch_Click"
          Content="&#xE711;"
          FontFamily="{ThemeResource SymbolThemeFontFamily}"
          ToolTipService.ToolTip="Close (Escape)"
        />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
