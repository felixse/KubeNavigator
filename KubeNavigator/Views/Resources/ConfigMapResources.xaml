<ResourceDictionary
  x:Class="KubeNavigator.Views.Resources.ConfigMapResources"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:customcontrols="using:KubeNavigator.Views.Controls"
  xmlns:local="using:KubeNavigator.Views.Resources"
  xmlns:resources="using:KubeNavigator.ViewModels.Resources"
  xmlns:viewmodels="using:KubeNavigator.ViewModels"
>
  <DataTemplate
    x:Key="ConfigMapTableHeader"
    x:DataType="viewmodels:KubernetesResourceTypeListViewModel"
  >
    <controls:DataTable ColumnSpacing="16">
      <controls:DataColumn Margin="12,0,0,0" DesiredWidth="Auto">
        <CheckBox MinWidth="36" IsChecked="{x:Bind IsAllSelected, Mode=TwoWay}" />
      </controls:DataColumn>
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Name"
        DesiredWidth="Auto"
      />
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Namespace"
        DesiredWidth="Auto"
      />
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Keys"
        DesiredWidth="Auto"
      />
      <controls:DataColumn
        CanResize="True"
        FontWeight="SemiBold"
        Content="Age"
        DesiredWidth="Auto"
      />
    </controls:DataTable>
  </DataTemplate>
  <DataTemplate x:Key="ConfigMapTableRow" x:DataType="resources:ConfigMapViewModel">
    <controls:DataRow
      HorizontalAlignment="Left"
      Background="Transparent"
      ContextFlyout="{x:Bind Converter={StaticResource ListItemToMenuConverter}}"
    >
      <CheckBox MinWidth="36" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Namespace}" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Keys, Mode=OneWay}" />
      <customcontrols:AgeTextBlock VerticalAlignment="Center" Timestamp="{x:Bind Age}" />
    </controls:DataRow>
  </DataTemplate>
</ResourceDictionary>
